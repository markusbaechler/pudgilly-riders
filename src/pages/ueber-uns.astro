---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import about from '../data/pages/about.json';
import team from '../data/team.json';
import timeline from '../data/timeline.json';
---

<BaseLayout title="Über uns" description="Die Geschichte, Werte und Menschen hinter dem Motorradclub Pudgilly Riders.">
  <PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    text={about.hero.text}
  />

  <section class="section">
    <div class="container">
      <div class="intro">
        <div>
          <span class="eyebrow">{about.history.eyebrow}</span>
          <h2>{about.history.heading}</h2>
        </div>
        <div>
          {about.history.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">{about.values.eyebrow}</span>
        <h2>{about.values.heading}</h2>
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          about.values.items.map((item) => (
            <article class="card">
              <div class="card__icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">{about.timelineHeading.eyebrow}</span>
      <h2>{about.timelineHeading.heading}</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline__item">
              <span class="timeline__year">{item.year}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">{about.teamHeading.eyebrow}</span>
        <h2>{about.teamHeading.heading}</h2>
      </div>
      <div class="grid grid--2 grid--team" style="margin-top: 2.5rem;">
        {
          team.map((member) => (
            <article class="card member">
              <span class="member__avatar" aria-hidden="true">{member.emoji}</span>
              <div>
                <h3>{member.name}</h3>
                <p class="member__role">{member.role}</p>
                <p class="member__bike">🏍️ {member.bike}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .timeline {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .timeline__item {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-accent);
  }

  @media (min-width: 640px) {
    .timeline__item {
      grid-template-columns: 100px 1fr;
      align-items: baseline;
    }
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .timeline__item p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .member {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .member__avatar {
    font-size: 2.75rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .member h3 {
    margin-bottom: 0.2rem;
    font-size: 1.15rem;
  }

  .member__role {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .member__bike {
    margin: 0.3rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
