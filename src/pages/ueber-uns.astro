---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const team = [
  { name: 'Marco "Pudge" Brunner', role: 'Präsident', bike: 'BMW R 1250 GS', emoji: '🧔' },
  { name: 'Sandra Keller', role: 'Tourenleiterin', bike: 'Yamaha Ténéré 700', emoji: '👩' },
  { name: 'Tobias Frei', role: 'Kassier', bike: 'Honda CB650R', emoji: '🧑' },
  { name: 'Nadine Roth', role: 'Events & Kommunikation', bike: 'Triumph Street Triple', emoji: '👩‍🦰' },
];

const timeline = [
  { year: '2009', text: 'Gründung durch sechs Freunde nach einer spontanen Alpentour.' },
  { year: '2013', text: 'Einweihung des eigenen Clubhauses mit Werkstatt.' },
  { year: '2018', text: 'Erste mehrtägige Auslandstour – die Dolomiten rufen.' },
  { year: '2024', text: 'Über 45 aktive Mitglieder und ein volles Tourenprogramm.' },
];
---

<BaseLayout title="Über uns" description="Die Geschichte, Werte und Menschen hinter dem Motorradclub Pudgilly Riders.">
  <PageHero
    eyebrow="Über uns"
    title="Wer wir sind"
    text="Eine bunt gemischte Truppe mit einem gemeinsamen Nenner: der Liebe zum Motorrad."
  />

  <section class="section">
    <div class="container">
      <div class="intro">
        <div>
          <span class="eyebrow">Unsere Geschichte</span>
          <h2>Aus einer Tour wurde ein Club</h2>
        </div>
        <div>
          <p>
            Angefangen hat alles 2009 mit sechs Freunden, einer Landkarte und
            dem Wunsch, die schönsten Pässe der Schweiz gemeinsam zu fahren. Aus
            der spontanen Ausfahrt wurde eine feste Truppe – und schliesslich
            der Motorradclub Pudgilly Riders.
          </p>
          <p>
            Heute sind wir ein eingespieltes Team aus Fahrerinnen und Fahrern
            jeden Alters und mit den unterschiedlichsten Maschinen. Was uns eint,
            ist die Freude an gemeinsamen Kilometern und gelebter Kameradschaft.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">Was uns wichtig ist</span>
        <h2>Unsere Werte</h2>
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <article class="card">
          <div class="card__icon">🛡️</div>
          <h3>Sicherheit zuerst</h3>
          <p>Vorausschauend fahren, aufeinander achten und regelmässig trainieren.</p>
        </article>
        <article class="card">
          <div class="card__icon">🌍</div>
          <h3>Offenheit</h3>
          <p>Jede Marke, jedes Modell, jedes Level ist willkommen. Hauptsache zwei Räder.</p>
        </article>
        <article class="card">
          <div class="card__icon">♻️</div>
          <h3>Respekt</h3>
          <p>Gegenüber der Natur, anderen Verkehrsteilnehmern und untereinander.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Meilensteine</span>
      <h2>Unsere Reise</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline__item">
              <span class="timeline__year">{item.year}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">Der Vorstand</span>
        <h2>Köpfe des Clubs</h2>
      </div>
      <div class="grid grid--2 grid--team" style="margin-top: 2.5rem;">
        {
          team.map((member) => (
            <article class="card member">
              <span class="member__avatar" aria-hidden="true">{member.emoji}</span>
              <div>
                <h3>{member.name}</h3>
                <p class="member__role">{member.role}</p>
                <p class="member__bike">🏍️ {member.bike}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .timeline {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .timeline__item {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-accent);
  }

  @media (min-width: 640px) {
    .timeline__item {
      grid-template-columns: 100px 1fr;
      align-items: baseline;
    }
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .timeline__item p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .member {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .member__avatar {
    font-size: 2.75rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .member h3 {
    margin-bottom: 0.2rem;
    font-size: 1.15rem;
  }

  .member__role {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .member__bike {
    margin: 0.3rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
