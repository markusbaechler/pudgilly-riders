---
import BaseLayout from '../layouts/BaseLayout.astro';

const plannerUrl = 'https://markusbaechler.github.io/motorbike/';
---

<BaseLayout
  title="Routenplaner"
  description="Plane kurvige Motorradtouren, Pässe und Übernachtungen mit dem Pudgilly-Riders-Routenplaner."
>
  <section class="planner">
    <iframe
      class="planner__frame"
      src={plannerUrl}
      title="Pudgilly Riders Routenplaner"
      loading="eager"
      allow="geolocation; clipboard-write; fullscreen"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
    <p class="planner__fallback">
      Der Routenplaner lädt nicht?
      <a href={plannerUrl} target="_blank" rel="noopener">In neuem Tab öffnen →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .planner {
    position: relative;
    background: var(--color-bg);
  }

  .planner__frame {
    display: block;
    width: 100%;
    /* Füllt den Bildschirm unter der fixierten Kopfzeile (72px) */
    height: calc(100dvh - 72px);
    min-height: 560px;
    border: 0;
  }

  .planner__fallback {
    margin: 0;
    padding: 0.75rem 1.5rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }
</style>
