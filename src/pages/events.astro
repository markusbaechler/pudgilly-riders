---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { events } from '../data/events';
import page from '../data/pages/events.json';
---

<BaseLayout title="Events" description="Termine der Pudgilly Riders: Ausfahrten, Stammtische, Kurse und Feste im Clubjahr.">
  <PageHero
    eyebrow={page.hero.eyebrow}
    title={page.hero.title}
    text={page.hero.text}
  />

  <section class="section">
    <div class="container">
      <ul class="event-list">
        {
          events.map((event) => (
            <li class="event-card">
              <div class="event-card__date">
                <time datetime={event.date}>{event.dateLabel}</time>
              </div>
              <div class="event-card__body">
                <span class:list={['badge', `badge--${event.type.toLowerCase()}`]}>
                  {event.type}
                </span>
                <h3>{event.title}</h3>
                <p class="event-card__loc">📍 {event.location}</p>
                <p>{event.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="text-center" style="margin-top: 3rem;">
        <p class="lead mx-auto" style="margin-bottom: 1.5rem;">{page.note}</p>
        <a href={page.ctaButtonHref} class="btn btn--primary">{page.ctaButtonLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .event-card {
    display: grid;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color var(--transition);
  }

  .event-card:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .event-card {
      grid-template-columns: 180px 1fr;
      align-items: start;
    }
  }

  .event-card__date time {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-accent);
    letter-spacing: 0.03em;
  }

  .event-card__body h3 {
    margin: 0.5rem 0 0.4rem;
  }

  .event-card__body p {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
  }

  .event-card__loc {
    font-size: 0.9rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }

  .badge--treffen {
    background: rgba(96, 165, 250, 0.14);
    color: #60a5fa;
  }

  .badge--fest {
    background: rgba(244, 114, 182, 0.14);
    color: #f472b6;
  }

  .badge--kurs {
    background: rgba(74, 222, 128, 0.14);
    color: #4ade80;
  }
</style>
