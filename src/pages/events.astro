---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EventCard from '../components/EventCard.astro';
import { upcomingEvents, pastEvents } from '../data/events';
import page from '../data/pages/events.json';
---

<BaseLayout title="Events" description="Termine der Pudgilly Riders: Ausfahrten, Treffen, Kurse und Feste im Clubjahr.">
  <PageHero
    eyebrow={page.hero.eyebrow}
    title={page.hero.title}
    text={page.hero.text}
  />

  <section class="section">
    <div class="container">
      {
        upcomingEvents.length === 0 ? (
          <p class="event-list__empty">
            Aktuell sind keine kommenden Termine eingetragen. Neue Ausfahrten kündigen wir hier und per
            WhatsApp an.
          </p>
        ) : (
          <ul class="event-list">
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </ul>
        )
      }

      <div class="text-center" style="margin-top: 3rem;">
        <p class="lead mx-auto" style="margin-bottom: 1.5rem;">{page.note}</p>
        <a href={page.ctaButtonHref} class="btn btn--primary">{page.ctaButtonLabel}</a>
      </div>
    </div>
  </section>

  {
    pastEvents.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <span class="eyebrow">Rückblick</span>
          <h2>Bereits vorbei</h2>
          <ul class="event-list" style="margin-top: 2rem;">
            {pastEvents.map((event) => (
              <EventCard event={event} past />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .event-list__empty {
    margin: 0;
    padding: 1.75rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
