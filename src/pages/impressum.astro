---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import team from '../data/team.json';

// Vertretungsberechtigte Person: der Präsident gemäss Vorstandsliste (team.json)
const president = team.find((m) => m.role === 'Präsident');
const phoneHref = site.phone.replace(/\s+/g, '');
---

<BaseLayout title="Impressum" description="Impressum der Website des Motorradclubs Pudgilly Riders.">
  <PageHero eyebrow="Rechtliches" title="Impressum" text="Wer hinter dieser Website steht." />

  <section class="section">
    <div class="container prose">
      <h2>Betreiber der Website</h2>
      <p>
        <strong>Pudgilly Riders</strong><br />
        Motorradclub, Verein mit Sitz in Hüttikon ZH<br />
        {site.address}<br />
        Schweiz
      </p>
      <p>
        E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a><br />
        Telefon: <a href={`tel:${phoneHref}`}>{site.phone}</a>
      </p>

      {
        president && (
          <>
            <h2>Vertretungsberechtigte Person</h2>
            <p>
              {president.name}, {president.role}
            </p>
          </>
        )
      }

      <h2>Hosting</h2>
      <p>Diese Website wird bei der green.ch AG in der Schweiz gehostet.</p>

      <h2>Haftungsausschluss</h2>
      <p>
        Wir erstellen die Inhalte dieser Website mit grösstmöglicher Sorgfalt. Für Richtigkeit,
        Vollständigkeit und Aktualität übernehmen wir keine Gewähr. Termine und Angaben zu Touren
        können sich kurzfristig ändern.
      </p>
      <p>
        Haftungsansprüche wegen Schäden materieller oder immaterieller Art, die aus dem Zugriff oder
        der Nutzung beziehungsweise Nichtnutzung der veröffentlichten Informationen entstehen, sind
        ausgeschlossen, soweit gesetzlich zulässig.
      </p>

      <h2>Links auf Websites Dritter</h2>
      <p>
        Verweise und Links auf Websites Dritter liegen ausserhalb unseres Verantwortungsbereichs.
        Der Zugriff auf solche Websites erfolgt auf eigene Verantwortung. Das gilt auch für den
        eingebetteten Routenplaner.
      </p>

      <h2>Urheberrechte</h2>
      <p>
        Texte, Fotos, Videos und das Logo auf dieser Website gehören den Pudgilly Riders oder den
        jeweils genannten Rechteinhabern. Eine Verwendung ohne unsere schriftliche Zustimmung ist
        nicht gestattet.
      </p>

      <h2>Datenschutz</h2>
      <p>
        Wie wir mit Personendaten umgehen, steht in unserer
        <a href="/datenschutz/">Datenschutzerklärung</a>.
      </p>
    </div>
  </section>
</BaseLayout>
