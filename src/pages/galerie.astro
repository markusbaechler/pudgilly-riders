---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gallery from '../data/gallery.json';
import page from '../data/pages/gallery.json';

// Alle Bilder aus src/assets/galerie. Astro verkleinert und komprimiert sie beim Build
// automatisch, statt die Original-Fotos (bis 4000 Pixel, über 700 KB) auszuliefern.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galerie/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}',
  { eager: true }
);

// "/galerie/foto.jpg" (Wert aus dem CMS) -> passendes Bild aus src/assets/galerie
function findImage(path?: string): ImageMetadata | undefined {
  if (!path) return undefined;
  const name = path.split('/').pop();
  const key = Object.keys(files).find((k) => k.endsWith('/' + name));
  return key ? files[key].default : undefined;
}

const items = gallery.map((item) => ({ ...item, img: findImage(item.image) }));
---

<BaseLayout title="Galerie" description="Eindrücke von Touren, Events und dem Clubleben der Pudgilly Riders.">
  <PageHero
    eyebrow={page.hero.eyebrow}
    title={page.hero.title}
    text={page.hero.text}
  />

  <section class="section">
    <div class="container">
      <div class="gallery">
        {
          items.map((item) => (
            <figure
              class="gallery__item"
              style={`--hue: ${item.hue};`}
            >
              {item.img ? (
                <div class="gallery__media">
                  <Image
                    src={item.img}
                    alt={item.caption}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px"
                    format="webp"
                    quality={78}
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="gallery__media gallery__media--placeholder" aria-hidden="true">
                  <span class="gallery__icon">🏍️</span>
                </div>
              )}
              <figcaption>
                <span class="gallery__tag">{item.tag}</span>
                {item.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="gallery__note">
        {page.note} <a href="/kontakt/">Kontakt aufnehmen →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: transform var(--transition), border-color var(--transition);
  }

  .gallery__item:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .gallery__media {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .gallery__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery__media--placeholder {
    background:
      linear-gradient(
        135deg,
        hsl(var(--hue) 55% 28%),
        hsl(calc(var(--hue) + 25) 50% 14%)
      );
  }

  .gallery__icon {
    font-size: 2.5rem;
    opacity: 0.85;
  }

  .gallery__item figcaption {
    padding: 1rem 1.1rem 1.2rem;
    font-size: 0.95rem;
  }

  .gallery__tag {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }

  .gallery__note {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
