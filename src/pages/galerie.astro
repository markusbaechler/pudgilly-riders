---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import gallery from '../data/gallery.json';
import page from '../data/pages/gallery.json';
---

<BaseLayout title="Galerie" description="Eindrücke von Touren, Events und dem Clubleben der Pudgilly Riders.">
  <PageHero
    eyebrow={page.hero.eyebrow}
    title={page.hero.title}
    text={page.hero.text}
  />

  <section class="section">
    <div class="container">
      <div class="gallery">
        {
          gallery.map((item) => (
            <figure
              class="gallery__item"
              style={`--hue: ${item.hue};`}
            >
              {item.image ? (
                <div class="gallery__media">
                  <img src={item.image} alt={item.caption} loading="lazy" />
                </div>
              ) : (
                <div class="gallery__media gallery__media--placeholder" aria-hidden="true">
                  <span class="gallery__icon">🏍️</span>
                </div>
              )}
              <figcaption>
                <span class="gallery__tag">{item.tag}</span>
                {item.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="gallery__note">
        {page.note} <a href="/kontakt/">Kontakt aufnehmen →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: transform var(--transition), border-color var(--transition);
  }

  .gallery__item:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .gallery__media {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .gallery__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery__media--placeholder {
    background:
      linear-gradient(
        135deg,
        hsl(var(--hue) 55% 28%),
        hsl(calc(var(--hue) + 25) 50% 14%)
      );
  }

  .gallery__icon {
    font-size: 2.5rem;
    opacity: 0.85;
  }

  .gallery__item figcaption {
    padding: 1rem 1.1rem 1.2rem;
    font-size: 0.95rem;
  }

  .gallery__tag {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }

  .gallery__note {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
