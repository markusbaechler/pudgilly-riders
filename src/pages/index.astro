---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tours } from '../data/tours';
import { events } from '../data/events';
import { site } from '../data/site';
import home from '../data/pages/home.json';

const topTours = tours.slice(0, 3);
const nextEvents = events.slice(0, 3);

const stats = [
  { value: String(site.stats.members), label: 'Mitglieder' },
  { value: String(site.stats.toursPerYear), label: 'Touren pro Jahr' },
  { value: String(site.stats.founded), label: 'Gegründet' },
  { value: '∞', label: 'Kilometer' },
];
---

<BaseLayout title="Start" description="Pudgilly Riders – Motorradclub für gemeinsame Touren, Events und gelebte Töff-Leidenschaft.">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="eyebrow">{home.hero.eyebrow}</span>
      <h1>{home.hero.titleLine1}<br />{home.hero.titleLine2}</h1>
      <p class="lead">{home.hero.lead}</p>
      <div class="hero__actions">
        <a href={home.hero.primaryCtaHref} class="btn btn--primary">{home.hero.primaryCtaLabel}</a>
        <a href={home.hero.secondaryCtaHref} class="btn btn--ghost">{home.hero.secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
  </section>

  <!-- Stats -->
  <section class="section section--alt">
    <div class="container">
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stats__item">
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="intro">
        <div>
          <span class="eyebrow">{home.intro.eyebrow}</span>
          <h2>{home.intro.heading}</h2>
        </div>
        <div>
          {home.intro.paragraphs.map((p) => <p>{p}</p>)}
          <a href={home.intro.linkHref} class="btn btn--ghost">{home.intro.linkLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Werte -->
  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">{home.values.eyebrow}</span>
        <h2>{home.values.heading}</h2>
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          home.values.items.map((item) => (
            <article class="card">
              <div class="card__icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Touren-Vorschau -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{home.toursPreview.eyebrow}</span>
          <h2>{home.toursPreview.heading}</h2>
        </div>
        <a href="/touren/" class="btn btn--ghost">Alle Touren →</a>
      </div>
      <div class="grid grid--3" style="margin-top: 2rem;">
        {
          topTours.map((tour) => (
            <article class="card tour-card">
              <span class="tour-card__level">{tour.level}</span>
              <h3>{tour.title}</h3>
              <p class="tour-card__region">{tour.region}</p>
              <p>{tour.description}</p>
              <div class="tour-card__meta">
                <span>📍 {tour.distance}</span>
                <span>⏱️ {tour.duration}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Events-Vorschau -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{home.eventsPreview.eyebrow}</span>
          <h2>{home.eventsPreview.heading}</h2>
        </div>
        <a href="/events/" class="btn btn--ghost">Alle Events →</a>
      </div>
      <ul class="event-list" style="margin-top: 2rem;">
        {
          nextEvents.map((event) => (
            <li class="event-row">
              <time class="event-row__date" datetime={event.date}>
                {event.dateLabel}
              </time>
              <div class="event-row__body">
                <h3>{event.title}</h3>
                <p>
                  <span class="badge">{event.type}</span> {event.location}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container text-center">
      <h2>{home.cta.heading}</h2>
      <p class="lead mx-auto" style="margin-bottom: 2rem;">{home.cta.lead}</p>
      <a href={home.cta.buttonHref} class="btn btn--primary">{home.cta.buttonLabel}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 30%, rgba(255, 107, 0, 0.22), transparent 50%),
      linear-gradient(160deg, #16161a 0%, #0d0d0f 60%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(4rem, 12vw, 9rem);
    max-width: 760px;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 78px,
        rgba(255, 255, 255, 0.02) 78px,
        rgba(255, 255, 255, 0.02) 80px
      );
    z-index: 1;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    color: var(--color-accent);
    line-height: 1;
  }

  .stats__label {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
  }

  .intro {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .tour-card {
    display: flex;
    flex-direction: column;
  }

  .tour-card__level {
    align-self: flex-start;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .tour-card__region {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: -0.25rem;
  }

  .tour-card__meta {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .event-row {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .event-row {
      grid-template-columns: 200px 1fr;
      align-items: center;
    }
  }

  .event-row__date {
    font-family: var(--font-display);
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .event-row__body h3 {
    margin-bottom: 0.25rem;
  }

  .event-row__body p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    margin-right: 0.4rem;
  }

  .cta {
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 107, 0, 0.15), transparent 60%);
  }
</style>
