---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingEvents } from '../data/events';
import { site } from '../data/site';
import home from '../data/pages/home.json';

// Nur kommende Termine (heute eingeschlossen), maximal drei
const nextEvents = upcomingEvents.slice(0, 3);

const stats = [
  { value: String(site.stats.members), label: 'Mitglieder' },
  { value: String(site.stats.toursPerYear), label: 'Touren pro Jahr' },
  { value: String(site.stats.founded), label: 'Gegründet' },
  { value: '∞', label: 'Kilometer' },
];
---

<BaseLayout title="Start" description="Pudgilly Riders – Motorradclub für gemeinsame Touren, Events und gelebte Töff-Leidenschaft.">
  <!-- Hero -->
  <section class="hero">
    <!-- Das Video wird erst per Script geladen (siehe unten), und nur ab Tablet-Breite.
         Handys zeigen das Standbild aus dem poster-Attribut. -->
    <video
      class="hero__video"
      loop
      muted
      playsinline
      preload="none"
      poster="/hero/hero.jpg"
      data-src="/hero/hero.mp4"
      aria-hidden="true"
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="container hero__inner">
      <span class="eyebrow">{home.hero.eyebrow}</span>
      <h1>{home.hero.titleLine1}<br />{home.hero.titleLine2}</h1>
      <p class="lead">{home.hero.lead}</p>
      <div class="hero__actions">
        <a href={home.hero.primaryCtaHref} class="btn btn--primary">{home.hero.primaryCtaLabel}</a>
        <a href={home.hero.secondaryCtaHref} class="btn btn--ghost">{home.hero.secondaryCtaLabel}</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--alt">
    <div class="container">
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stats__item">
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="intro">
        <div>
          <span class="eyebrow">{home.intro.eyebrow}</span>
          <h2>{home.intro.heading}</h2>
        </div>
        <div>
          {home.intro.paragraphs.map((p) => <p>{p}</p>)}
          <a href={home.intro.linkHref} class="btn btn--ghost">{home.intro.linkLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Werte -->
  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">{home.values.eyebrow}</span>
        <h2>{home.values.heading}</h2>
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          home.values.items.map((item) => (
            <article class="card">
              <div class="card__icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Routenplaner-Teaser -->
  <section class="section">
    <div class="container">
      <div class="planner-cta">
        <div class="planner-cta__text">
          <span class="eyebrow">Routenplaner</span>
          <h2>Plane deine nächste Tour</h2>
          <p class="lead">
            Kurvige Strecken über kleine Strassen und Pässe, Tag für Tag mit
            Übernachtungen – und am Schluss GPX fürs Navi. Tour-Genius und
            Pässeplaner bauen dir auf Wunsch ganze Touren.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
            <a href="/planer/" class="btn btn--primary">Zum Routenplaner →</a>
            <a href="/touren/" class="btn btn--ghost">Club-Touren ansehen</a>
          </div>
        </div>
        <div class="planner-cta__visual" aria-hidden="true">
          <span class="planner-cta__icon">🗺️</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Events-Vorschau -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{home.eventsPreview.eyebrow}</span>
          <h2>{home.eventsPreview.heading}</h2>
        </div>
        <a href="/events/" class="btn btn--ghost">Alle Events →</a>
      </div>
      {
        nextEvents.length === 0 ? (
          <p class="event-list__empty">
            Aktuell sind keine Termine eingetragen. Neue Ausfahrten kündigen wir hier und per WhatsApp an.
          </p>
        ) : (
          <ul class="event-list" style="margin-top: 2rem;">
            {nextEvents.map((event) => (
              <li class="event-row">
                <time class="event-row__date" datetime={event.date}>
                  {event.dateLabel}
                </time>
                <div class="event-row__body">
                  <h3>{event.title}</h3>
                  <p>
                    <span class="badge">{event.type}</span> {event.location}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container text-center">
      <h2>{home.cta.heading}</h2>
      <p class="lead mx-auto" style="margin-bottom: 2rem;">{home.cta.lead}</p>
      <a href={home.cta.buttonHref} class="btn btn--primary">{home.cta.buttonLabel}</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero-Video nur auf grösseren Bildschirmen laden. Handys, Datensparmodus und
  // "Bewegung reduzieren" bekommen das Standbild – das spart rund 2 MB pro Besuch.
  const video = document.querySelector<HTMLVideoElement>('.hero__video');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const wantsVideo =
    window.matchMedia('(min-width: 768px)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !saveData;

  if (video && wantsVideo && video.dataset.src) {
    video.src = video.dataset.src;
    video.play().catch(() => {
      /* Autoplay blockiert – das Standbild bleibt sichtbar */
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Standbild als Basis – sichtbar, solange das Video lädt oder nicht abspielt */
    background:
      linear-gradient(160deg, #1b1916 0%, #100f12 60%),
      url('/hero/hero.jpg');
    background-size: cover;
    background-position: center;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Abdunklung für gute Lesbarkeit des Textes */
    background:
      linear-gradient(90deg, rgba(16, 15, 18, 0.85) 0%, rgba(16, 15, 18, 0.45) 55%, rgba(16, 15, 18, 0.2) 100%),
      linear-gradient(180deg, rgba(16, 15, 18, 0.1) 60%, rgba(16, 15, 18, 0.78) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(5rem, 14vw, 11rem);
    max-width: 760px;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Animationen reduzieren: Video ausblenden, Standbild bleibt sichtbar */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    color: var(--color-accent);
    line-height: 1;
  }

  .stats__label {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
  }

  .intro {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .planner-cta {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 85% 20%, rgba(255, 138, 30, 0.18), transparent 55%),
      var(--color-surface);
  }

  @media (min-width: 820px) {
    .planner-cta {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .planner-cta__visual {
    display: grid;
    place-items: center;
  }

  .planner-cta__icon {
    font-size: clamp(4rem, 12vw, 7rem);
    filter: drop-shadow(0 12px 30px rgba(240, 90, 40, 0.35));
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .event-list__empty {
    margin: 2rem 0 0;
    padding: 1.75rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }

  .event-row {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .event-row {
      grid-template-columns: 200px 1fr;
      align-items: center;
    }
  }

  .event-row__date {
    font-family: var(--font-display);
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .event-row__body h3 {
    margin-bottom: 0.25rem;
  }

  .event-row__body p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    margin-right: 0.4rem;
  }

  .cta {
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 107, 0, 0.15), transparent 60%);
  }
</style>
