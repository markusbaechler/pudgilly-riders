---
import type { ClubEvent } from '../data/events';

interface Props {
  event: ClubEvent;
  /** Vergangene Termine werden abgeschwächt dargestellt */
  past?: boolean;
}

const { event, past = false } = Astro.props;
---

<li class:list={['event-card', { 'event-card--past': past }]}>
  <div class="event-card__date">
    <time datetime={event.date}>{event.dateLabel}</time>
  </div>
  <div class="event-card__body">
    <span class:list={['badge', `badge--${event.type.toLowerCase()}`]}>
      {event.type}
    </span>
    <h3>{event.title}</h3>
    {event.location && <p class="event-card__loc">📍 {event.location}</p>}
    {event.description && <p>{event.description}</p>}
  </div>
</li>

<style>
  .event-card {
    display: grid;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color var(--transition), opacity var(--transition);
  }

  .event-card:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .event-card {
      grid-template-columns: 180px 1fr;
      align-items: start;
    }
  }

  .event-card__date time {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-accent);
    letter-spacing: 0.03em;
  }

  .event-card__body h3 {
    margin: 0.5rem 0 0.4rem;
  }

  .event-card__body p {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
  }

  .event-card__loc {
    font-size: 0.9rem;
  }

  /* Vergangene Termine: zurückhaltend, ohne Hover-Akzent */
  .event-card--past {
    opacity: 0.6;
  }

  .event-card--past:hover {
    border-color: var(--color-border);
    opacity: 0.85;
  }

  .event-card--past .event-card__date time {
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }

  .badge--treffen {
    background: rgba(96, 165, 250, 0.14);
    color: #60a5fa;
  }

  .badge--fest {
    background: rgba(244, 114, 182, 0.14);
    color: #f472b6;
  }

  .badge--kurs {
    background: rgba(74, 222, 128, 0.14);
    color: #4ade80;
  }
</style>
