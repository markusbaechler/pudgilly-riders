---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {text && <p class="lead">{text}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 107, 0, 0.18), transparent 45%),
      linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero .lead {
    margin-top: 1rem;
  }
</style>
